# Copy to .env and fill in YOUR OWN values. Never commit .env.

# Jev: pick a route, then fill in that route's key (docs/verified_apis.md, "Jev routes").
# Check one with:  python scripts/probe_jev.py
#   direct     TypeSafe API (waitlist)            jev-1.13.0
#   openrouter OpenRouter (beta)                  typesafe/jev-1.13
#   zen        OpenCode Zen                       jev-1.13      ($0.042/Mtok input)
#   vercel     Vercel AI Gateway                  typesafe-ai/jev
#   bocha      Bocha (free, limited time)         bocha-jev-v1  (NOT TypeSafe's model: dev only)
JEV_TRANSPORT=openrouter
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=
AI_GATEWAY_API_KEY=
BOCHA_API_KEY=

# Generator (Gemma 4). Default route: OpenRouter's chat API, which uses OPENROUTER_API_KEY
# (results/DECISIONS.md). For a self-hosted vLLM server instead (notebooks/colab_gemma.ipynb):
#   GEMMA_API=completions, GEMMA_BASE_URL=<server>/v1, GEMMA_MODEL=google/gemma-4-E4B-it
# Gemini API instead (AI Studio key, free tier): GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   and GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
GEMMA_API=chat
GEMMA_BASE_URL=https://openrouter.ai/api/v1
GEMMA_MODEL=google/gemma-4-26b-a4b-it
GEMMA_TOKENIZER=google/gemma-4-26B-A4B-it   # HF tokenizer id (OpenRouter ids aren't HF ids)
GEMMA_API_KEY=            # self-hosted server's password; unset = OPENROUTER_API_KEY on OpenRouter

# Hugging Face (gated model / dataset downloads)
HF_TOKEN=

# Where the Jev disk cache lives (never in a synced folder)
JEV_CACHE_DIR=.cache/jev

# Kaggle GPU jobs (scripts/kaggle_run.py): token from kaggle.com/settings -> API
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
