# Copy to .env and fill in YOUR OWN values. Never commit .env.

# Jev (Person 2 documents which route we use in docs/verified_apis.md)
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Gemma server (OpenAI-compatible completions endpoint: SGLang / vLLM / Ollama)
GEMMA_BASE_URL=http://localhost:8000/v1
GEMMA_MODEL=google/gemma-4-E4B-it

# Hugging Face (gated model / dataset downloads)
HF_TOKEN=

# Who is running (1-4); written into the Jev spend log
TZ_PERSON=

# Where the Jev disk cache lives (never in a synced folder)
JEV_CACHE_DIR=.cache/jev
